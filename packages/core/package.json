{
  "name": "@accurona/core",
  "version": "0.4.0",
  "description": "Accurona's framework-free core for Axonometra: the scene format (a Zod schema, with a generated JSON Schema), length units and the keymap.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "scene-format",
    "floor-plan",
    "network-diagram",
    "units",
    "keymap",
    "zod"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qant-au/accurona.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/qant-au/accurona#readme",
  "bugs": {
    "url": "https://github.com/qant-au/accurona/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema/scene-v1.json": "./schema/scene-v1.json",
    "./schema/scene-v2.json": "./schema/scene-v2.json"
  },
  "files": [
    "dist",
    "schema"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && node scripts/schema.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "zod": "^4.6.5"
  }
}
